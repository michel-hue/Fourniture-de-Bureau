# ============================================================
# WorkStore — variables d'environnement du FRONT (Vite)
# Copier ce fichier vers `.env` puis adapter les valeurs.
# Tout préfixe VITE_ est exposé côté navigateur : ne jamais
# y mettre de secret.
# ============================================================

# URL de base de l'API NestJS.
# - en dev : laisser vide (proxy Vite /api -> http://localhost:3000, voir vite.config.ts)
# - en prod : URL absolue, ex. https://api.workstore.ci
VITE_API_URL=

# Domaine public du site — utilisé pour les canonical / Open Graph / sitemap
# (point unique : src/hooks/usePageMeta.ts, fallback https://www.workstore.ci)
VITE_SITE_URL=https://www.workstore.ci

# Google Analytics 4 (optionnel — le bandeau cookies ne l'active qu'après consentement)
VITE_GA_ID=
